{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "label",
    "scene_summary",
    "primary_categories",
    "secondary_categories",
    "is_noise",
    "rationale",
    "content_type",
    "register",
    "exclude_from_axes"
  ],
  "properties": {
    "content_type": {
      "type": "string",
      "enum": [
        "scene",
        "discourse",
        "paratext",
        "subgenre_marker",
        "procedural_transition",
        "noise"
      ]
    },
    "register": {
      "type": "string",
      "enum": ["explicit", "suggestive", "neutral"]
    },
    "exclude_from_axes": { "type": "boolean" },
    "subgenre_hints": {
      "type": "array",
      "items": { "type": "string" }
    },
    "merge_group_hint": {
      "type": ["string", "null"]
    },
    "label": { "type": "string", "minLength": 1 },
    "scene_summary": { "type": "string" },
    "primary_categories": {
      "type": "array",
      "items": { "type": "string" }
    },
    "secondary_categories": {
      "type": "array",
      "items": { "type": "string" }
    },
    "is_noise": { "type": "boolean" },
    "rationale": { "type": "string" }
  },
  "additionalProperties": true
}
