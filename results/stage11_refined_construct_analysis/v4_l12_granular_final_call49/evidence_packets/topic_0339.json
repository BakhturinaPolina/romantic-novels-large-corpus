      },
      {
        "sid": "BOOK_012_4",
        "book_id_anon": "BOOK_012",
        "cell": "CELL_B",
        "sentence": "When at last my gaze lands on something that isn't the ceiling or the wall, I find myself suddenly arrested by a man sitting across the bar.",
