      },
      {
        "sid": "BOOK_011_3",
        "book_id_anon": "BOOK_011",
        "cell": "CELL_B",
        "sentence": "Music was playing and the small bar area was full, mainly with older men in their 60s, laughing and joking with the short, white-haired man of the same age serving up the drinks.",
        "max_topic_prob": 0.48491233587265015,
        "normalized_position": 0.142456533931576,
