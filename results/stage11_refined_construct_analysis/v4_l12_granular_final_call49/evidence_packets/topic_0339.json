      {
        "sid": "BOOK_012_3",
        "book_id_anon": "BOOK_012",
        "cell": "CELL_B",
        "sentence": "I decide to go for it, knowing I'm not being any more indecent than anyone else in this bar.",
        "max_topic_prob": 0.5991650819778442,
