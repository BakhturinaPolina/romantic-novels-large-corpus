      {
        "sid": "BOOK_002_middle_1",
        "book_id_anon": "BOOK_002",
        "cell": "POS_002",
        "sentence": "Jesus said, \"If you cannot forgive those who have wronged you, your Father can't forgive you.\" (",
        "max_topic_prob": 0.6984937787055969,
        "normalized_position": 0.43223583460949466,
        "tertile": "middle",
