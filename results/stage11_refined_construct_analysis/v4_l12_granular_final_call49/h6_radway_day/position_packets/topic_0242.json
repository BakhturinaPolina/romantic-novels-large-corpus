        "normalized_position": 0.40160796324655434,
        "tertile": "middle",
        "chapter_index": 8,
        "sentence_index": 218
      },
      {
        "sid": "BOOK_002_middle_3",
        "book_id_anon": "BOOK_002",
        "cell": "POS_002",
        "sentence": "Think of the deep work God does in our hearts when we have to do what is most difficult—forgive those who do not deserve forgiveness.",
